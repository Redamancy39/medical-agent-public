              },
              {
                "end": 5978,
                "quote": "such as anemia",
                "start": 5964
              },
              {
                "end": 6132,
                "quote": "Kidney failure and liver disease can also affect A1C results.",
                "start": 6071
              },
              {
                "end": 4570,
                "quote": "don't stop taking any medicines unless your provider tells you to.",
                "start": 4504
              }
