          "document_id": "nlm-uacr-test",
          "source_sha256": "3772202d3291e1828d35291338b1af2ccdbd7e8264959fbc0cdb1ecdc1670946",
          "start": 952,
          "end": 1065,
          "quote": "The microalbumin creatinine ratio test compares the levels of albumin in your urine to your levels of creatinine."
