    },
    {
      "case_id": "basic-03",
      "point_index": 1,
      "text": "钙通道阻滞剂帮助血管放松",
      "kind": "medical_fact",
      "support_status": "supported",
      "evidence": [
        {
          "document_id": "nlm-bp-medicines",
