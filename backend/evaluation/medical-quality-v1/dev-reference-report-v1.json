    },
    {
      "case_id": "basic-16",
      "point_index": 1,
      "text": "异常白蛋白漏出可能提示早期肾病",
      "kind": "medical_fact",
      "support_status": "supported",
      "evidence": [
        {
          "document_id": "nlm-uacr-test",
          "source_sha256": "3772202d3291e1828d35291338b1af2ccdbd7e8264959fbc0cdb1ecdc1670946",
          "start": 152,
          "end": 224,
          "quote": "Abnormal amounts of this protein may be an early sign of kidney disease."
