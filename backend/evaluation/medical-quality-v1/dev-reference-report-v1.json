    {
      "case_id": "basic-01",
      "point_index": 0,
      "text": "心脏搏动时为收缩压",
      "kind": "medical_fact",
      "support_status": "supported",
      "evidence": [
        {
          "document_id": "nlm-hypertension",
          "source_sha256": "6ef444154364630f65a7934b794d754cff2a841ba77becaee2995afac4245dba",
          "start": 173,
          "end": 279,
          "quote": "Your blood pressure is highest when your heart beats, pumping the blood. This is called systolic pressure."
        }
      ],
      "policy_rules": [],
      "note": "原文可支持该要点；支持位置与旧绑定分开核对。",
      "professional_review": "pending",
      "anchor_status": "passed",
      "citation_status": "citation_gap"
    },
    {
      "case_id": "basic-01",
      "point_index": 1,
      "text": "两次搏动之间为舒张压",
      "kind": "medical_fact",
      "support_status": "supported",
      "evidence": [
        {
          "document_id": "nlm-hypertension",
          "source_sha256": "6ef444154364630f65a7934b794d754cff2a841ba77becaee2995afac4245dba",
          "start": 280,
          "end": 384,
          "quote": "When your heart is at rest, between beats, your blood pressure falls. This is called diastolic pressure."
        }
      ],
      "policy_rules": [],
      "note": "原文可支持该要点；支持位置与旧绑定分开核对。",
      "professional_review": "pending",
      "anchor_status": "passed",
      "citation_status": "citation_gap"
    },
    {
      "case_id": "basic-01",
      "point_index": 2,
      "text": "120对应收缩压、80对应舒张压",
      "kind": "medical_fact",
      "support_status": "supported",
      "evidence": [
        {
          "document_id": "nlm-hypertension",
          "source_sha256": "6ef444154364630f65a7934b794d754cff2a841ba77becaee2995afac4245dba",
          "start": 523,
          "end": 576,
          "quote": "120/80 means a systolic of 120 and a diastolic of 80."
        }
      ],
      "policy_rules": [],
      "note": "原文可支持该要点；支持位置与旧绑定分开核对。",
      "professional_review": "pending",
      "anchor_status": "passed",
      "citation_status": "bound"
    },
    {
      "case_id": "basic-03",
      "point_index": 0,
      "text": "利尿剂排出多余水和钠",
      "kind": "medical_fact",
      "support_status": "supported",
      "evidence": [
        {
          "document_id": "nlm-bp-medicines",
          "source_sha256": "2686229dca0816049a1c687b4ad1e0ee381355f7f4e53bce2ed8c72e24336504",
          "start": 1569,
          "end": 1608,
          "quote": "Diuretics remove extra water and sodium"
