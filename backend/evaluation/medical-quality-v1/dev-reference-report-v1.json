    {
      "case_id": "basic-04",
      "point_index": 0,
      "text": "运动和咖啡因可影响读数",
      "kind": "medical_fact",
      "support_status": "supported",
      "evidence": [
        {
          "document_id": "nlm-bp-test",
          "source_sha256": "3605f16f26b8d7e9b90bc28b81899c1087f316e5e7b09d78aff92f295c6c3d75",
          "start": 5277,
          "end": 5489,
          "quote": "To get a more accurate blood pressure measurement, avoid these things for at least 30 minutes before having your blood pressure taken:\n\n- Exercise\n- Alcohol\n- Tobacco products\n- Food or drinks containing caffeine"
        }
      ],
      "policy_rules": [],
      "note": "原文可支持该要点；支持位置与旧绑定分开核对。",
      "professional_review": "pending",
      "anchor_status": "passed",
      "citation_status": "citation_gap"
    },
    {
      "case_id": "basic-04",
      "point_index": 1,
      "text": "NLM提示至少30分钟前避免相关活动/饮食",
      "kind": "medical_fact",
      "support_status": "supported",
      "evidence": [
        {
          "document_id": "nlm-bp-test",
          "source_sha256": "3605f16f26b8d7e9b90bc28b81899c1087f316e5e7b09d78aff92f295c6c3d75",
          "start": 5277,
          "end": 5489,
          "quote": "To get a more accurate blood pressure measurement, avoid these things for at least 30 minutes before having your blood pressure taken:\n\n- Exercise\n- Alcohol\n- Tobacco products\n- Food or drinks containing caffeine"
        }
      ],
      "policy_rules": [],
      "note": "保留30分钟与具体活动条件，不能只绑定孤立数字。",
      "professional_review": "pending",
      "anchor_status": "passed",
      "citation_status": "citation_gap"
    },
    {
      "case_id": "basic-04",
      "point_index": 2,
      "text": "排空膀胱和合适坐姿",
      "kind": "medical_fact",
      "support_status": "supported",
      "evidence": [
        {
          "document_id": "nlm-bp-test",
          "source_sha256": "3605f16f26b8d7e9b90bc28b81899c1087f316e5e7b09d78aff92f295c6c3d75",
          "start": 5497,
          "end": 5545,
          "quote": "make sure to go to the bathroom before the test."
        },
        {
          "document_id": "nlm-bp-test",
          "source_sha256": "3605f16f26b8d7e9b90bc28b81899c1087f316e5e7b09d78aff92f295c6c3d75",
          "start": 3337,
          "end": 3394,
          "quote": "You will sit in a chair with your feet flat on the floor."
        }
      ],
      "policy_rules": [],
      "note": "排空膀胱与坐姿分别有原文支持。",
      "professional_review": "pending",
      "anchor_status": "passed",
      "citation_status": "citation_gap"
    },
    {
      "case_id": "basic-07",
      "point_index": 0,
      "text": "细胞对胰岛素响应不正常",
      "kind": "medical_fact",
      "support_status": "supported",
      "evidence": [
        {
          "document_id": "nlm-type2-diabetes",
          "source_sha256": "fefe9a051cee4bd59fbd229d3e3940e3329d3edd61955db48213c9af0233d196",
          "start": 851,
          "end": 925,
          "quote": "This is a condition in which your cells don't respond normally to insulin."
        }
      ],
      "policy_rules": [],
      "note": "原文可支持该要点；支持位置与旧绑定分开核对。",
      "professional_review": "pending",
      "anchor_status": "passed",
      "citation_status": "citation_gap"
    },
    {
      "case_id": "basic-07",
      "point_index": 1,
      "text": "葡萄糖难以进入细胞、血中升高",
      "kind": "medical_fact",
      "support_status": "supported",
      "evidence": [
        {
          "document_id": "nlm-type2-diabetes",
          "source_sha256": "fefe9a051cee4bd59fbd229d3e3940e3329d3edd61955db48213c9af0233d196",
          "start": 366,
          "end": 439,
          "quote": "The glucose then stays in your blood and not enough goes into your cells."
        }
      ],
      "policy_rules": [],
      "note": "原文可支持该要点；支持位置与旧绑定分开核对。",
      "professional_review": "pending",
      "anchor_status": "passed",
      "citation_status": "citation_gap"
    },
    {
      "case_id": "basic-07",
      "point_index": 2,
      "text": "随时间胰岛素生成也可能不足",
      "kind": "medical_fact",
      "support_status": "supported",
      "evidence": [
        {
          "document_id": "nlm-type2-diabetes",
          "source_sha256": "fefe9a051cee4bd59fbd229d3e3940e3329d3edd61955db48213c9af0233d196",
          "start": 1077,
          "end": 1164,
          "quote": "But over time, your body can't make enough insulin, and your blood glucose levels rise."
        }
      ],
      "policy_rules": [],
      "note": "原文可支持该要点；支持位置与旧绑定分开核对。",
      "professional_review": "pending",
      "anchor_status": "passed",
      "citation_status": "citation_gap"
    },
    {
      "case_id": "basic-11",
      "point_index": 0,
      "text": "反映过去约2–3个月平均",
      "kind": "medical_fact",
      "support_status": "supported",
      "evidence": [
        {
          "document_id": "nlm-a1c-test",
          "source_sha256": "88534028573f92f5cacdba47c1c63bdd767886bcb5547bb8f1644b935256016a",
          "start": 40,
          "end": 193,
          "quote": "A hemoglobin A1C (HbA1C) test is a blood test that shows your average level of blood glucose, also called blood sugar, over the past two to three months."
        }
      ],
      "policy_rules": [],
      "note": "原文可支持该要点；支持位置与旧绑定分开核对。",
      "professional_review": "pending",
      "anchor_status": "passed",
      "citation_status": "citation_gap"
    },
    {
      "case_id": "basic-11",
      "point_index": 1,
      "text": "并非当前时点读数",
      "kind": "medical_fact",
      "support_status": "supported",
      "evidence": [
        {
          "document_id": "nlm-a1c-test",
          "source_sha256": "88534028573f92f5cacdba47c1c63bdd767886bcb5547bb8f1644b935256016a",
          "start": 1431,
          "end": 1526,
          "quote": "If you're checking it at home, you are measuring what your blood glucose level is at that time."
