    {
      "case_id": "basic-16",
      "point_index": 2,
      "text": "早期肾病可能没有症状",
      "kind": "medical_fact",
      "support_status": "supported",
      "evidence": [
        {
          "document_id": "nlm-uacr-test",
          "source_sha256": "3772202d3291e1828d35291338b1af2ccdbd7e8264959fbc0cdb1ecdc1670946",
          "start": 1287,
          "end": 1451,
          "quote": "A microalbumin creatinine ratio test is most often used to look for signs of kidney disease in people who have a high risk of developing it but don't have symptoms."
