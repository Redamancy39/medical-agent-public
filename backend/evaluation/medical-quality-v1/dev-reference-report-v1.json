      ],
      "policy_rules": [],
      "note": "原文可支持该要点；支持位置与旧绑定分开核对。",
      "professional_review": "pending",
      "anchor_status": "passed",
      "citation_status": "citation_gap"
    },
    {
      "case_id": "basic-16",
      "point_index": 0,
      "text": "比较尿白蛋白与肌酐",
      "kind": "medical_fact",
      "support_status": "supported",
      "evidence": [
