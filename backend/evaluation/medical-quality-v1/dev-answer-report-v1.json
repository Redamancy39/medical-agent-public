      "result_status": "completed",
      "claims": [
        {
          "start": 0,
          "end": 26,
          "text": "血压是血液对动脉壁的压力，单位毫米汞柱(mmHg)。",
          "kind": "medical_fact",
          "support_status": "supported",
          "evidence": [
            {
              "document_id": "nlm-hypertension",
              "source_sha256": "6ef444154364630f65a7934b794d754cff2a841ba77becaee2995afac4245dba",
              "start": 25,
              "end": 110,
              "quote": "Blood pressure is the force of your blood pushing against the walls of your arteries."
            },
            {
              "document_id": "nlm-bp-test",
              "source_sha256": "3605f16f26b8d7e9b90bc28b81899c1087f316e5e7b09d78aff92f295c6c3d75",
              "start": 6022,
              "end": 6074,
              "quote": "Blood pressure is measured in millimeters of mercury"
            }
          ],
          "policy_rules": [],
          "note": "逐句核对当前固定原文，来源支持与专业正确分开。",
          "professional_review": "pending",
          "anchor_status": "passed",
          "citation_status": "citation_gap"
        },
        {
          "start": 26,
          "end": 52,
          "text": "收缩压是心脏搏动（收缩）时的压力，即读数中第一个数；",
          "kind": "medical_fact",
          "support_status": "supported",
          "evidence": [
            {
              "document_id": "nlm-hypertension",
              "source_sha256": "6ef444154364630f65a7934b794d754cff2a841ba77becaee2995afac4245dba",
              "start": 173,
              "end": 279,
              "quote": "Your blood pressure is highest when your heart beats, pumping the blood. This is called systolic pressure."
            },
            {
              "document_id": "nlm-hypertension",
              "source_sha256": "6ef444154364630f65a7934b794d754cff2a841ba77becaee2995afac4245dba",
              "start": 438,
              "end": 509,
              "quote": "Usually the systolic number comes before or above the diastolic number."
            }
          ],
          "policy_rules": [],
          "note": "逐句核对当前固定原文，来源支持与专业正确分开。",
          "professional_review": "pending",
          "anchor_status": "passed",
          "citation_status": "citation_gap"
        },
        {
          "start": 52,
          "end": 77,
          "text": "舒张压是两次搏动之间心脏休息时的压力，即第二个数。",
          "kind": "medical_fact",
          "support_status": "supported",
          "evidence": [
            {
              "document_id": "nlm-hypertension",
              "source_sha256": "6ef444154364630f65a7934b794d754cff2a841ba77becaee2995afac4245dba",
              "start": 280,
              "end": 384,
              "quote": "When your heart is at rest, between beats, your blood pressure falls. This is called diastolic pressure."
            },
            {
              "document_id": "nlm-hypertension",
              "source_sha256": "6ef444154364630f65a7934b794d754cff2a841ba77becaee2995afac4245dba",
              "start": 438,
              "end": 509,
              "quote": "Usually the systolic number comes before or above the diastolic number."
            }
          ],
          "policy_rules": [],
          "note": "逐句核对当前固定原文，来源支持与专业正确分开。",
          "professional_review": "pending",
          "anchor_status": "passed",
          "citation_status": "citation_gap"
        },
        {
          "start": 77,
          "end": 100,
          "text": "以120/80为例：收缩压120，舒张压80。",
          "kind": "medical_fact",
          "support_status": "supported",
          "evidence": [
            {
              "document_id": "nlm-hypertension",
              "source_sha256": "6ef444154364630f65a7934b794d754cff2a841ba77becaee2995afac4245dba",
              "start": 523,
              "end": 576,
              "quote": "120/80 means a systolic of 120 and a diastolic of 80."
            }
          ],
          "policy_rules": [],
          "note": "逐句核对当前固定原文，来源支持与专业正确分开。",
          "professional_review": "pending",
          "anchor_status": "passed",
          "citation_status": "bound"
        },
        {
          "start": 102,
          "end": 142,
          "text": "资料为美国NLM内容的编辑摘述、未经医学专业复核，分类与阈值并非各地区统一标准。",
          "kind": "corpus_scope",
          "support_status": "supported",
          "evidence": [],
          "policy_rules": [],
          "note": "NLM编辑/复核状态可核实；不同地区阈值未在本语料逐项比较，不能将免责声明视为地区对照已完成。",
          "professional_review": "pending",
          "anchor_status": "not_applicable",
          "citation_status": "not_applicable"
        },
        {
          "start": 142,
          "end": 153,
          "text": "单次数值不能远程确诊；",
          "kind": "project_behavior",
          "support_status": "supported",
          "evidence": [],
          "policy_rules": [
            "educational_scope",
            "medicines"
          ],
          "note": "这是项目回答行为约束，不作为医学原文证据。",
          "professional_review": "pending",
          "anchor_status": "not_applicable",
          "citation_status": "not_applicable"
        },
        {
          "start": 153,
          "end": 193,
          "text": "判断通常需不同日期两次或以上偏高等读数，并结合个人及家族史、症状由医护人员评估。",
          "kind": "medical_fact",
          "support_status": "supported",
          "evidence": [
            {
              "document_id": "nlm-bp-test",
              "source_sha256": "3605f16f26b8d7e9b90bc28b81899c1087f316e5e7b09d78aff92f295c6c3d75",
              "start": 6596,
              "end": 6737,
              "quote": "Your provider will only usually diagnose you with high blood pressure if you have two or more high blood pressure readings on different days."
            },
            {
              "document_id": "nlm-bp-test",
              "source_sha256": "3605f16f26b8d7e9b90bc28b81899c1087f316e5e7b09d78aff92f295c6c3d75",
              "start": 6738,
              "end": 6924,
              "quote": "They may also consider your blood pressure readings over a period of time, your medical and family history, and if you have other symptoms before diagnosing you with high blood pressure."
            }
          ],
          "policy_rules": [],
          "note": "逐句核对当前固定原文，来源支持与专业正确分开。",
          "professional_review": "pending",
          "anchor_status": "passed",
          "citation_status": "citation_gap"
        },
        {
          "start": 193,
          "end": 203,
          "text": "用药与剂量须遵医嘱。",
          "kind": "project_behavior",
          "support_status": "supported",
          "evidence": [],
          "policy_rules": [
            "educational_scope",
            "medicines"
          ],
          "note": "这是项目回答行为约束，不作为医学原文证据。",
          "professional_review": "pending",
          "anchor_status": "not_applicable",
          "citation_status": "not_applicable"
        }
      ]
    },
    {
      "case_id": "scenario-03",
      "run_id": "7fa677b3-6929-4205-ab36-05d80f24d2ef",
      "answer_sha256": "9605b2ae7f2d851caf306b347a09713485236f30ee11983d3b0539311b706bfd",
      "result_status": "completed",
      "claims": [
        {
          "start": 0,
          "end": 5,
          "text": "不能判断。",
          "kind": "project_behavior",
          "support_status": "supported",
          "evidence": [],
          "policy_rules": [
            "clarify",
            "educational_scope"
          ],
          "note": "这是项目回答行为约束，不作为医学原文证据。",
          "professional_review": "pending",
          "anchor_status": "not_applicable",
          "citation_status": "not_applicable"
        },
        {
          "start": 5,
          "end": 147,
          "text": "解读血糖必须先确定单位与采血情境：参考范围用mg/dL（空腹正常≤99、前期100–125、糖尿病≥126），mmol/L数值体系不同，无单位无法对照[9100b16f5fcec9acf2383412330ab89e0a0f1fe048acab0d539c7c2352319b14]。",
          "kind": "medical_fact",
          "support_status": "partially_supported",
          "evidence": [
            {
              "document_id": "nlm-prediabetes",
              "source_sha256": "68719b122e0df5c3a341bae51da5d1ee2cccfd7a06ebddc48dbde0beff6cc394",
              "start": 2294,
              "end": 2453,
              "quote": "The results of the test are given in mg/dL (milligrams per deciliter): A normal level is 99 or below Prediabetes is 100 to 125 Type 2 diabetes is 126 and above"
            }
          ],
          "policy_rules": [],
          "note": "mg/dL阈值有原文；mmol/L说明未由该引用直接覆盖，数值应保持检测条件，不能当个人确诊。",
          "professional_review": "pending",
          "anchor_status": "passed",
          "citation_status": "citation_gap"
        },
        {
          "start": 147,
          "end": 309,
          "text": "空腹、随机、OGTT、HbA1c含义各异，是否需空腹也不同[fc9127cc166c1d78c56f5a11623bd28bd8f4b31c39977ff5fca1f93f4234d30c][b286bdb501fb296a0c9a1061af3949ef36cee314edb6efbc4eb5c8e6f5b34fa3]。",
          "kind": "medical_fact",
          "support_status": "supported",
          "evidence": [
            {
              "document_id": "nlm-diabetes-tests",
              "source_sha256": "00eea6f5d7e0c01800693826cf672d4b8630e2745f2117798b563940da2534c9",
              "start": 6665,
              "end": 6761,
              "quote": "You will need to fast (not eat or drink) for a blood glucose and an oral glucose tolerance test."
            },
            {
              "document_id": "nlm-diabetes-tests",
              "source_sha256": "00eea6f5d7e0c01800693826cf672d4b8630e2745f2117798b563940da2534c9",
              "start": 6763,
              "end": 6904,
              "quote": "You don't need any special preparations for a random blood sugar test, glucose challenge test, hemoglobin A1c test, or glucose in urine test."
            }
          ],
          "policy_rules": [],
          "note": "逐句核对当前固定原文，来源支持与专业正确分开。",
          "professional_review": "pending",
          "anchor_status": "passed",
          "citation_status": "citation_gap"
        },
        {
          "start": 309,
          "end": 420,
          "text": "仅凭报告一个数字不能远程确诊，单次结果通常需重复检测或结合其他检查，异常值意义由医护解释[fc9127cc166c1d78c56f5a11623bd28bd8f4b31c39977ff5fca1f93f4234d30c]。",
          "kind": "medical_fact",
          "support_status": "supported",
          "evidence": [
            {
              "document_id": "nlm-diabetes-tests",
              "source_sha256": "00eea6f5d7e0c01800693826cf672d4b8630e2745f2117798b563940da2534c9",
              "start": 4741,
              "end": 4783,
              "quote": "It may be repeated to confirm a diagnosis."
            },
            {
              "document_id": "nlm-a1c-test",
              "source_sha256": "88534028573f92f5cacdba47c1c63bdd767886bcb5547bb8f1644b935256016a",
              "start": 5325,
              "end": 5385,
              "quote": "Providers often use more than one test to diagnose diabetes."
            }
          ],
          "policy_rules": [],
          "note": "重复/多种检测有支持；个体结果须解释为项目边界，不能仅凭数值确诊。",
          "professional_review": "pending",
          "anchor_status": "passed",
          "citation_status": "citation_gap"
        },
        {
          "start": 420,
          "end": 450,
          "text": "资料为美国NLM成人科普，非中国指南，应携完整报告就诊复核。",
          "kind": "corpus_scope",
          "support_status": "supported",
          "evidence": [],
          "policy_rules": [],
          "note": "当前20份NLM公开资料及编辑/复核元数据支持此范围说明，不推断其他库。",
          "professional_review": "pending",
          "anchor_status": "not_applicable",
          "citation_status": "not_applicable"
        }
      ]
    },
