          "professional_review": "pending",
          "anchor_status": "passed",
          "citation_status": "citation_gap"
        },
        {
          "start": 344,
          "end": 425,
          "text": "贫血、肾衰竭、肝病可影响结果[784f41de56811ca3741391817578fd7aa37c4e68a58fdd902b9002ba16f66aa4]。",
          "kind": "medical_fact",
