# Copy to .env for a new checkout. Never commit .env or API key values.
DEEPSEEK_API_KEY=
MEM0_API_KEY=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING_ENABLED=false

DEEPSEEK_ENABLED=false
MEM0_ENABLED=false
WEB_SEARCH_ENABLED=false
KNOWLEDGE_ENABLED=false
KNOWLEDGE_PROFILE=synthetic
# medical profile uses data/knowledge_medical_v1.db when the default path below is unchanged.
KNOWLEDGE_PATH=data/knowledge_v3.db
EMBEDDING_CACHE=data/models
RERANKER_ENABLED=false
RERANKER_PATH=D:/rag_project/models/reranker/bge-reranker-v2-m3
# auto: CUDA available -> GPU FP16, otherwise CPU. cuda: fail if unavailable.
RERANKER_DEVICE=auto
MAINTENANCE_ENABLED=true
PROVIDER_TIMEOUT_SECONDS=15
MODEL_MAX_TOKENS=768
MEDICAL_REVIEWER_ENABLED=true
REVIEWER_MAX_TOKENS=1400

APP_ENV=local
DATABASE_PATH=data/app.db
JWT_SECRET=
