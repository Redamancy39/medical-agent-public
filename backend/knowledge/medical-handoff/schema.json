{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 800,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "access_status": {
          "enum": [
            "opened",
            "unavailable"
          ],
          "title": "Access Status",
          "type": "string"
        }
      },
      "required": [
        "url",
        "locator",
        "access_status"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "PointAudit": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "reference_point": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reference Point",
          "type": "string"
        },
        "reference_kind": {
          "default": "medical_fact",
          "enum": [
            "medical_fact",
            "project_behavior"
          ],
          "title": "Reference Kind",
          "type": "string"
        },
        "issue_type": {
          "enum": [
            "none",
            "citation_gap",
            "unsupported_claim",
            "contradicted_claim",
            "scope_or_version_mismatch",
            "source_metadata_issue",
            "unavailable"
          ],
          "title": "Issue Type",
          "type": "string"
        },
        "support_status": {
          "enum": [
            "supported",
            "partially_supported",
            "contradicted",
            "insufficient_evidence"
          ],
          "title": "Support Status",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 10,
          "title": "Evidence",
          "type": "array"
        },
        "rule_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Rule Ids",
          "type": "array"
        },
        "suggested_change": {
          "default": "",
          "maxLength": 3000,
          "title": "Suggested Change",
          "type": "string"
        },
        "professional_review": {
          "const": "pending",
          "default": "pending",
          "title": "Professional Review",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "reference_point",
        "issue_type",
        "support_status"
      ],
      "title": "PointAudit",
      "type": "object"
    },
    "SourceCandidate": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,100}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "publisher": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher"
        },
        "publication_date": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Date"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "jurisdiction": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jurisdiction"
        },
        "population": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population"
        },
        "reuse_status": {
          "default": "unconfirmed",
          "enum": [
            "verified",
            "unconfirmed",
            "unavailable"
          ],
          "title": "Reuse Status",
          "type": "string"
        },
        "reuse_evidence_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reuse Evidence Url"
        },
        "access_status": {
          "enum": [
            "opened",
            "unavailable"
          ],
          "title": "Access Status",
          "type": "string"
        },
        "notes": {
          "default": "",
          "maxLength": 2000,
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "url",
        "access_status"
      ],
      "title": "SourceCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "medical-handoff-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "batch_id": {
      "pattern": "^[a-zA-Z0-9_-]{1,100}$",
      "title": "Batch Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceCandidate"
      },
      "maxItems": 100,
      "title": "Sources",
      "type": "array"
    },
    "audits": {
      "items": {
        "$ref": "#/$defs/PointAudit"
      },
      "maxItems": 1000,
      "title": "Audits",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "batch_id",
    "created_at"
  ],
  "title": "HandoffBatch",
  "type": "object"
}