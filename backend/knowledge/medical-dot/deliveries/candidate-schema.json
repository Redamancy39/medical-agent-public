{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "medical-eval-candidates-v1 — synthetic, unvalidated candidate question batches",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "created_at",
    "origin",
    "medical_gold_standard",
    "professional_review",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "medical-eval-candidates-v1"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,100}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "const": "synthetic_cloud_research_draft"
    },
    "medical_gold_standard": {
      "const": false
    },
    "professional_review": {
      "const": "pending"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "rule_id",
        "rule_text",
        "policy_file_sha256"
      ],
      "properties": {
        "policy_version": {
          "const": "medical-qa-policy-v1"
        },
        "rule_id": {
          "enum": [
            "educational_scope",
            "clarify",
            "unknown",
            "medicines",
            "urgent",
            "privacy",
            "untrusted_sources"
          ]
        },
        "rule_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "policy_file_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_id",
        "source_family_id",
        "version",
        "url",
        "locator",
        "quote",
        "normalized_text_sha256",
        "delivered_body_reference",
        "source_batch_id",
        "accessed_at",
        "read_scope",
        "jurisdiction",
        "professional_review"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "source_family_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "normalized_text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "delivered_body_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "source_batch_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "accessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "read_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "jurisdiction": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "professional_review": {
          "const": "pending"
        }
      }
    },
    "reference_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point_id",
        "reference_kind",
        "reference_point",
        "evidence_ids",
        "policy_evidence",
        "professional_review"
      ],
      "properties": {
        "point_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "reference_kind": {
          "enum": [
            "medical_fact",
            "project_behavior"
          ]
        },
        "reference_point": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "maxItems": 20
        },
        "policy_evidence": {
          "type": "array",
          "minItems": 0,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/policy"
          }
        },
        "professional_review": {
          "const": "pending"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reference_kind": {
                "const": "medical_fact"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              },
              "policy_evidence": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reference_kind": {
                "const": "project_behavior"
              }
            }
          },
          "then": {
            "properties": {
              "policy_evidence": {
                "minItems": 1
              },
              "evidence_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "family_id",
        "category",
        "question",
        "expected_action",
        "action_policy_evidence",
        "reference_points",
        "prohibited_conclusions",
        "evidence",
        "scope_note",
        "professional_review"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "family_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "category": {
          "enum": [
            "knowledge",
            "measurement_conditions",
            "source_comparison",
            "insufficient_information",
            "out_of_knowledge_base",
            "severe_risk_boundary"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "expected_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "action_policy_evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/policy"
          }
        },
        "reference_points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/reference_point"
          }
        },
        "prohibited_conclusions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "scope_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "professional_review": {
          "const": "pending"
        }
      }
    }
  }
}
